# Trucee crank worker config. Copy to worker/.env (git-ignored) and fill in real values.
# `npm start` loads worker/.env when it exists; variables set in the shell win over the file.
# Never commit .env: RPC_URL embeds a provider API key.

# Cluster the crank runs against: devnet | mainnet-beta | localnet (required)
CLUSTER=devnet

# http(s) RPC endpoint (required). For devnet use the DEVNET_RPC value from litesvm-diff/.env.
RPC_URL=https://rpc.example.invalid/?api-key=YOUR_API_KEY

# Crank payer keypair, in either form (default ~/.config/solana/id.json):
#   - a path to a solana-keygen JSON keypair file (a leading ~ is your home directory), or
#   - the keypair itself, inline: the file's JSON array of 64 numbers (each 0-255) on one line, written like
#     CRANK_KEYPAIR=[1,2,...] with all 64 numbers. ECS injects this form from SSM.
# A value starting with [ is always read as an inline array, so prefix such a relative path with ./
# Either form is a signing secret: never commit a real key. Errors and logs never echo an inline array.
CRANK_KEYPAIR=~/.config/solana/id.json

# Milliseconds between the end of one tick and the start of the next (default 15000, minimum 100)
CRANK_INTERVAL_MS=15000

# Transactions the crank may send per tick across all jobs (default 10)
MAX_TX_PER_TICK=10

# The crank pays the rent (~0.00204 SOL) of each owner quote ATA it creates, and an owner can close that ATA and keep it.
# A missing ATA is created only for a payout (the auto-exit refund, or the surplus share) of at least this many
# lamports; smaller payouts are left to the owner. Breakeven, assuming the ~1% router fee: an attacker who buys and then
# exits pays about 2 x 1% x payout, so farming one ATA's rent pays only below a payout of ~0.00204 / 0.02 = ~0.1 SOL.
# The default, 250000000 (0.25 SOL), keeps a margin above that. This key sets the wSOL minimum only: xStocks use fixed
# raw-unit minimums (an ATA for 0.1 share = 10000000 raw), and quote mints the cluster does not list are skipped.
# Digits only.
MIN_ATA_VALUE_LAMPORTS=250000000

# Owner quote ATAs each job (auto-exit, claims) may create per tick (default 2)
MAX_ATA_CREATES_PER_TICK=2

# Jobs plan nothing while the crank payer holds fewer lamports than this (default 50000000 = 0.05 SOL)
CRANK_MIN_SOL_LAMPORTS=50000000

# The migrate job skips wSOL pools whose migration quote threshold is below this many lamports.
# Empty means the cluster default: 0 on devnet and localnet, 1000000000 (1 SOL) on mainnet-beta.
# wSOL only: xStock pools need a threshold of at least 1 share (100000000 raw), and pools of quote mints the cluster
# does not list are not migrated by the crank. Digits only.
MIN_MIGRATE_THRESHOLD_SOL_LAMPORTS=
