# Trucee crank worker config. Copy to worker/.env (git-ignored) and fill in real values.
# `npm start` loads worker/.env when it exists; variables set in the shell win over the file.
# Never commit .env: RPC_URL embeds a provider API key.

# Cluster the crank runs against: devnet | mainnet-beta | localnet (required)
CLUSTER=devnet

# http(s) RPC endpoint (required). For devnet use the DEVNET_RPC value from litesvm-diff/.env.
RPC_URL=https://rpc.example.invalid/?api-key=YOUR_API_KEY

# Path to the crank payer's solana-keygen JSON keypair (default ~/.config/solana/id.json)
CRANK_KEYPAIR=~/.config/solana/id.json

# Milliseconds between the end of one tick and the start of the next (default 15000, minimum 100)
CRANK_INTERVAL_MS=15000

# Transactions the crank may send per tick across all jobs (default 10)
MAX_TX_PER_TICK=10

# The crank pays the rent (~0.002 SOL) of each owner quote ATA it creates, and an owner can close that ATA and keep it.
# A missing ATA is created only for a payout (auto-exit refund, surplus share) of at least this many quote base units
# (lamports for SOL); smaller payouts are left to the owner (default 50000000 = 0.05 SOL)
MIN_ATA_VALUE_LAMPORTS=50000000

# Owner quote ATAs each job (auto-exit, claims) may create per tick (default 2)
MAX_ATA_CREATES_PER_TICK=2

# Jobs plan nothing while the crank payer holds fewer lamports than this (default 50000000 = 0.05 SOL)
CRANK_MIN_SOL_LAMPORTS=50000000

# The migrate job skips wSOL pools whose migration quote threshold is below this many lamports.
# Empty means the cluster default: 0 on devnet and localnet, 1000000000 (1 SOL) on mainnet-beta.
MIN_MIGRATE_THRESHOLD_SOL_LAMPORTS=
