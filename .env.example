# Trucee crank worker config. Copy to worker/.env (git-ignored) and fill in real values.
# `npm start` loads worker/.env when it exists; variables set in the shell win over the file.
# Never commit .env: RPC_URL embeds a provider API key.

# Cluster the crank runs against: devnet | mainnet-beta | localnet (required)
CLUSTER=devnet

# http(s) RPC endpoint (required). For devnet use the DEVNET_RPC value from litesvm-diff/.env.
RPC_URL=https://rpc.example.invalid/?api-key=YOUR_API_KEY

# Path to the crank payer's solana-keygen JSON keypair (default ~/.config/solana/id.json)
CRANK_KEYPAIR=~/.config/solana/id.json

# Milliseconds between the end of one tick and the start of the next (default 15000, minimum 100)
CRANK_INTERVAL_MS=15000

# Transactions the crank may send per tick across all jobs (default 10)
MAX_TX_PER_TICK=10
